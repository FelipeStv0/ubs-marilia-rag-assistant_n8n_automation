# Gere segredos aleatorios antes de iniciar (veja scripts/gerar_env.py).
POSTGRES_PASSWORD=SUBSTITUIR_POR_SEGREDO_ALEATORIO
# Compatibilidade/recuperacao da instancia legada. O n8n migrado usa .env privado separado.
N8N_ENCRYPTION_KEY=SUBSTITUIR_POR_CHAVE_DE_32_OU_MAIS_CARACTERES
# Recomendado para respostas generativas e busca vetorial. Sem chave, o sistema opera
# no modo de trechos oficiais com busca lexical, sem geração por LLM.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
